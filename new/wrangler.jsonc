{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new",
  "main": "src/index.tsx",
  "compatibility_date": "2026-05-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "shamo-new.mi-wada.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
		{
			"binding": "DB",
			"database_name": "shamo-api-db",
			"database_id": "8c1cce3c-92e0-4251-a44f-c40f6591eee3"
		}
	]
